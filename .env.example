# Copy to .env on the VPS and fill in the secret.
# Generate a value with: openssl rand -base64 32
# IMPORTANT: use the SAME value as the Vercel deployment if users already have
# a score-check cookie, otherwise those cookies will need to be re-issued.
ADIKARA_REVEAL_SECRET=replace-with-a-long-random-secret

NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0
NEXT_TELEMETRY_DISABLED=1
